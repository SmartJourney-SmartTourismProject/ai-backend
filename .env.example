# SmartJourney AI Backend — environment configuration
#
# Copy to .env and fill in. Setup instructions, free-tier limits and what
# breaks without each key: docs/master_plan/API_SETUP.md
# Verify everything at once:  python scripts/check_apis.py
#
# 🔴 = required   🟢 = recommended/optional   ⚪ = low value
# No key below requires a credit card.


# ─────────────────────────── 🔴 LLM ───────────────────────────
# https://aistudio.google.com/apikey — free, no card, ~15 RPM / ~1,500 RPD.
# Check YOUR real ceiling at https://aistudio.google.com/rate-limit
GEMINI_API_KEY=

LLM_TEMPERATURE=0

# Failover chain, tried in order on 429/503/timeout (decision D6b).
# Format: <provider>:<model>, comma separated. Providers with no key are skipped.
LLM_PROVIDER_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.6-flash,groq:openai/gpt-oss-120b

# 🟢 https://console.groq.com — free, no card. 30 RPM / 1,000 RPD / 8K TPM.
# Failover only: 8K tokens-per-minute is too tight to be the primary.
GROQ_API_KEY=


# ─────────────────────── 🟡 RAG knowledge base (app/rag/) ───────────────────────
# Off until the knowledge base is seeded — see
# `python -m app.data.pipeline --source knowledge_wikivoyage`.
ENABLE_RAG=false

# Same <provider>:<model> chain shape as LLM_PROVIDER_CHAIN. Uses
# GEMINI_API_KEY above — free tier, no separate key needed today.
# To switch to a paid OpenAI embedding model later: set
# EMBEDDING_PROVIDER_CHAIN=openai:text-embedding-3-small, add
# OPENAI_API_KEY, and `pip install openai` — then re-run the ingest
# connectors (a provider/dimension switch needs a full re-embed).
EMBEDDING_PROVIDER_CHAIN=gemini:gemini-embedding-001
EMBEDDING_DIM=768
OPENAI_API_KEY=


# ─────────────────────── 🔴 Database & cache ───────────────────────
# Same instance as backend/.env — but NOT the same string.
# backend/.env uses Prisma's form ending in "?schema=public"; psycopg2 and
# asyncpg REJECT that parameter ("invalid dsn: invalid URI query parameter").
# Same host/port/db/credentials, no query string.
# Start it with:  cd backend && docker compose up -d --wait
# Leaving this blank is what makes every lookup fall back to mock data.
DATABASE_URL=postgresql://smartjourney:localdev@localhost:5432/smartjourney

# Without this, app/utils/cache.py silently no-ops and weather is re-fetched
# on every single request.
REDIS_URL=redis://localhost:6379/0


# ─────────────────────── 🔴 Weather & hazards ───────────────────────
# https://openweathermap.org/api — free plan, no card, 1,000 calls/day.
# Uses /data/2.5/weather + /data/2.5/forecast.
# Do NOT switch to One Call API 3.0 — that one requires a card.
OPENWEATHER_API_KEY=

# Disaster feeds (EONET / USGS / GDACS), Overpass, Nominatim and ip-api.com
# are all keyless. Nothing to configure — but respect Nominatim's 1 req/s
# policy; the geo_resolution cache is what keeps us compliant.


# ─────────────────────── 🟢 Google Calendar consent ───────────────────────
# Free-day detection. Distinct from NestJS's Google *sign-in* client —
# different scopes, different redirect URI. See backend/docs/BACKEND_PLAN.md §2.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/google/callback


# ─────────────────────── 🟢 Routing & enrichment ───────────────────────
# https://account.heigit.org/manage/key — free, no card. The dashboard
# auto-provisions a "Basic Key"; you no longer create a named token.
# Turns proximity scoring from straight-line km into real road minutes.
#
# Quota note: Matrix V2 (what we use) is 500/day @ 40/min — a much smaller
# budget than Directions V2's 2,000/day. One many-to-many matrix call per
# district per plan, never per-pair.
ORS_API_KEY=

# api.openrouteservice.org is deprecated and throttled since Aug 2026.
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# https://rapidapi.com — subscribe to booking-com15 (free plan).
# Real nightly hotel prices; without it hotel costs come from cost_reference.
BOOKING_RAPIDAPI_KEY=
BOOKING_RAPIDAPI_HOST=booking-com15.p.rapidapi.com


# ─────────────────────── ⚪ Events ───────────────────────
# https://developer.ticketmaster.com — free, 5,000/day.
# Known to return ~zero events for Sri Lanka; real coverage will come from
# admin-entered events. Configured so the connector isn't dead code.
TICKETMASTER_API_KEY=


# ─────────────────────── Server & behaviour ───────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Base currency is LKR everywhere (decision D14). This rate is for display
# conversion only and for converting Booking.com's USD prices at ingest.
USD_LKR_RATE=310

# ReAct bounds (AGENT_ARCHITECTURE.md §2.1)
REACT_MAX_STEPS=3
REACT_TOOL_BUDGET=12


# ─────────────────────── Dropped — do not re-add ───────────────────────
# YELP_FUSION_API_KEY   no Sri Lanka coverage
# EVENTBRITE_API_KEY    public event search API discontinued in 2019
# GOOGLE_MAPS_API_KEY   requires billing; Nominatim + PostGIS cover our needs

# --- Admin > AI models ---
# Encrypts provider API keys saved in the admin panel (32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be identical in backend/.env and ai-backend/.env.
SETTINGS_ENCRYPTION_KEY=
# Shared secret NestJS sends to the AI backend's /internal/llm/* routes (same in both .env files).
INTERNAL_API_TOKEN=
# Also required (as X-Internal-Token) by /trip-plan and /api/admin/sync/* once set; empty = those stay open (dev only).
# Browser origins allowed by CORS (comma-separated). Default is localhost only.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional paid providers (or add the keys in Admin > AI models instead)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
