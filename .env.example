GEMINI_API_KEY=

# Same PostgreSQL (PostGIS) instance the NestJS backend owns - start it with
# `docker compose up -d` in ../backend. Leave blank to run standalone on mock data.
DATABASE_URL=postgresql://smartjourney:localdev@localhost:5432/smartjourney

OPENWEATHER_API_KEY=

TICKETMASTER_API_KEY=

YELP_FUSION_API_KEY=

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# RapidAPI key for the Booking.com API (real hotel nightly prices, monthly refresh)
BOOKING_RAPIDAPI_KEY=


REDIS_URL=redis://localhost:6379/0
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/google/callback
